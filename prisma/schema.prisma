  users_id         BigInt    @db.UnsignedBigInt
  users            users     @relation(fields: [users_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_preferences_users1")

  @@index([users_id], map: "fk_user_preferences_users1_idx")
}

