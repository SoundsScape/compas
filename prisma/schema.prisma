  tasks           tasks     @relation(fields: [tasks_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "submissions_tasks_id_foreign")

  @@index([submitted_by], map: "submissions_submitted_by_foreign")
  @@index([tasks_id], map: "submissions_tasks_id_foreign")
}

model tags {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name        String        @unique(map: "tags_name_unique") @db.VarChar(50)
  created_at  DateTime?     @db.Timestamp(0)
