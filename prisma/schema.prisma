  musicians    musicians @relation(fields: [musicians_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rel_musician_contents_musicians1")

  @@unique([musicians_id, contents_id], map: "rel_musician_contents_musicians_id_contents_id_unique")
  @@index([contents_id], map: "fk_rel_musician_contents_contents1_idx")
  @@index([musicians_id], map: "fk_rel_musician_contents_musicians1_idx")
}

model rel_musicians_eras {
  id            BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  musicians_id  BigInt     @db.UnsignedBigInt
  music_eras_id BigInt     @db.UnsignedBigInt
  created_at    DateTime   @default(now()) @db.Timestamp(0)
  updated_at    DateTime?  @db.Timestamp(0)
  music_eras    music_eras @relation(fields: [music_eras_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rel_musicians_eras_music_eras1")
  musicians     musicians  @relation(fields: [musicians_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rel_musicians_eras_musicians1")

  @@unique([musicians_id, music_eras_id], map: "rel_musicians_eras_musicians_id_music_eras_id_unique")
  @@index([music_eras_id], map: "fk_rel_musicians_eras_music_eras1_idx")
  @@index([musicians_id], map: "fk_rel_musicians_eras_musicians1_idx")
}

model rel_musicians_genres {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  musicians_id    BigInt       @db.UnsignedBigInt
  music_genres_id BigInt       @db.UnsignedBigInt
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  updated_at      DateTime?    @db.Timestamp(0)
  music_genres    music_genres @relation(fields: [music_genres_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rel_musicians_genres_music_genres1")
  musicians       musicians    @relation(fields: [musicians_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rel_musicians_genres_musicians1")

  @@unique([musicians_id, music_genres_id], map: "rel_musicians_genres_musicians_id_music_genres_id_unique")
  @@index([music_genres_id], map: "fk_rel_musicians_genres_music_genres1_idx")
  @@index([musicians_id], map: "fk_rel_musicians_genres_musicians1_idx")
}

model rel_users_chats {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  users_id  BigInt   @db.UnsignedBigInt
  chats_id  BigInt   @db.UnsignedBigInt
  joined_at DateTime @default(now()) @db.Timestamp(0)
  chats     chats    @relation(fields: [chats_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rel_users_chats_chats1")
  users     users    @relation(fields: [users_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rel_users_chats_users1")

  @@unique([users_id, chats_id], map: "rel_users_chats_users_id_chats_id_unique")
  @@index([chats_id], map: "fk_rel_users_chats_chats1_idx")
  @@index([users_id], map: "fk_rel_users_chats_users1_idx")
}

model roles {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  role_name   String    @db.VarChar(45)
  description String?   @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  users       users[]
}

model schools {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name          String    @db.VarChar(45)
  address       String    @db.VarChar(255)
  contact_mail  String    @unique(map: "contact_mail_UNIQUE") @db.VarChar(45)
  contact_phone String    @db.VarChar(45)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  users         users[]
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model statuses {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  status_name     String            @unique(map: "statuses_status_name_unique") @db.VarChar(45)
  description     String?           @db.Text
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  calendar_events calendar_events[]
  messages        messages[]
  notifications   notifications[]
  tasks           tasks[]
  users           users[]
}

model submissions {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  submission_date DateTime  @default(now()) @db.Timestamp(0)
