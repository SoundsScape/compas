generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model article_tag {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  article_id BigInt    @db.UnsignedBigInt
  tag_id     BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  articles   articles  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_tag_article_id_foreign")
  tags       tags      @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_tag_tag_id_foreign")

  @@index([article_id], map: "article_tag_article_id_foreign")
  @@index([tag_id], map: "article_tag_tag_id_foreign")
}

model article_templates {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  created_at    DateTime      @default(now()) @db.Timestamp(0)
  updated_at    DateTime      @default(now()) @db.Timestamp(0)
  type          String        @db.VarChar(255)
  order         Int
  shortCitation String?       @db.VarChar(400)
  article_id    BigInt        @db.UnsignedBigInt
  articles      articles      @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_templates_article_id_foreign")
  image_areas   image_areas[]
  text_areas    text_areas[]

  @@index([article_id], map: "article_templates_article_id_foreign")
}

model articles {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  updated_at        DateTime            @default(now()) @db.Timestamp(0)
  titulo            String              @db.VarChar(255)
  nombre_autor      String              @db.VarChar(255)
  apellidos_autor   String              @db.VarChar(255)
  id_autor          BigInt?             @db.UnsignedBigInt
  validated         Boolean             @default(false)
  centro            String              @db.VarChar(255)
  latitud           String              @db.VarChar(255)
  longitud          String              @db.VarChar(255)
  bibliografia      String              @db.VarChar(4000)
  fecha             Int
  article_tag       article_tag[]
  article_templates article_templates[]
  users             users?              @relation(fields: [id_autor], references: [id], onUpdate: NoAction, map: "articles_id_autor_foreign")

  @@index([id_autor], map: "articles_id_autor_foreign")
}

model assignements {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  assigned_to BigInt    @db.UnsignedBigInt
  tasks_id    BigInt    @db.UnsignedBigInt
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  tasks       tasks     @relation(fields: [tasks_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignements_tasks1")
  users       users     @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignements_users1")

  @@unique([assigned_to, tasks_id], map: "assignements_assigned_to_tasks_id_unique")
  @@index([tasks_id], map: "fk_assignements_tasks1_idx")
  @@index([assigned_to], map: "fk_assignements_users1_idx")
}

model audit_trials {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt?   @db.UnsignedBigInt
  action      String    @db.VarChar(10)
  table_name  String    @db.VarChar(45)
  record_id   BigInt    @db.UnsignedBigInt
  old_values  String?   @db.LongText
  new_values  String?   @db.LongText
  ip_address  String?   @db.VarChar(45)
  user_agent  String?   @db.Text
  description String?   @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_trials_user_id_foreign")

  @@index([user_id], map: "fk_audit_trials_users1_idx")
}

model calendar_events {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title          String    @db.VarChar(45)
  description    String?   @db.Text
  start_datetime DateTime  @default(now()) @db.Timestamp(0)
  end_datetime   DateTime  @default(now()) @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  statuses_id    BigInt    @db.UnsignedBigInt
  created_by     BigInt    @db.UnsignedBigInt
  users          users     @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "calendar_events_created_by_foreign")
  statuses       statuses  @relation(fields: [statuses_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "calendar_events_statuses_id_foreign")

  @@index([created_by], map: "calendar_events_created_by_foreign")
  @@index([statuses_id], map: "calendar_events_statuses_id_foreign")
}

model chats {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  name            String            @db.VarChar(50)
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  created_by      BigInt            @db.UnsignedBigInt
  users           users             @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chats_created_by_foreign")
  messages        messages[]
  rel_users_chats rel_users_chats[]

  @@unique([name, created_by], map: "chats_name_created_by_unique")
  @@index([created_by], map: "chats_created_by_foreign")
}

model cities {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  city       String    @db.VarChar(255)
  city_ascii String    @db.VarChar(255)
  lat        Decimal   @db.Decimal(10, 8)
  lng        Decimal   @db.Decimal(11, 8)
  country    String    @db.VarChar(255)
  iso2       String    @db.VarChar(2)
  iso3       String    @db.VarChar(3)
  admin_name String?   @db.VarChar(255)
  capital    String?   @db.VarChar(255)
  population Int?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model content_types {
  id        BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  name      String     @db.VarChar(45)
  extension String     @unique(map: "content_types_extension_unique") @db.VarChar(10)
  contents  contents[]
}

model contents {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  title                 String                  @db.VarChar(45)
  description           String?                 @db.Text
  file_path             String                  @db.VarChar(100)
  created_at            DateTime                @default(now()) @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  music_eras_id         BigInt                  @db.UnsignedBigInt
  music_genres_id       BigInt                  @db.UnsignedBigInt
  content_types_id      BigInt                  @db.UnsignedBigInt
  content_types         content_types           @relation(fields: [content_types_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contents_content_types_id_foreign")
  music_eras            music_eras              @relation(fields: [music_eras_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contents_music_eras_id_foreign")
  music_genres          music_genres            @relation(fields: [music_genres_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contents_music_genres_id_foreign")
  rel_musician_contents rel_musician_contents[]

  @@index([content_types_id], map: "contents_content_types_id_foreign")
  @@index([music_eras_id], map: "contents_music_eras_id_foreign")
  @@index([music_genres_id], map: "contents_music_genres_id_foreign")
}

model image_areas {
  id                BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  created_at        DateTime          @default(now()) @db.Timestamp(0)
  updated_at        DateTime          @default(now()) @db.Timestamp(0)
  imagePath         String            @db.VarChar(255)
  imageFooter       String            @db.VarChar(50)
  order             Int
  template_id       BigInt            @db.UnsignedBigInt
  article_templates article_templates @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "image_areas_template_id_foreign")

  @@index([template_id], map: "image_areas_template_id_foreign")
}

model logs {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  action      String    @db.VarChar(45)
  table_name  String    @db.VarChar(45)
  record_id   Int
  timestamp   DateTime  @default(now()) @db.Timestamp(0)
  description String?   @db.Text
  users_id    BigInt    @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  users       users     @relation(fields: [users_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "logs_users_id_foreign")

  @@index([users_id], map: "logs_users_id_foreign")
}

model messages {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  content          String   @db.Text
  sent_at          DateTime @default(now()) @db.Timestamp(0)
  sender_id        BigInt   @db.UnsignedBigInt
  receiver_chat_id BigInt   @db.UnsignedBigInt
  statuses_id      BigInt   @db.UnsignedBigInt
  chats            chats    @relation(fields: [receiver_chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_receiver_chat_id_foreign")
  users            users    @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_sender_id_foreign")
  statuses         statuses @relation(fields: [statuses_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_statuses_id_foreign")

  @@index([receiver_chat_id], map: "messages_receiver_chat_id_foreign")
  @@index([sender_id], map: "messages_sender_id_foreign")
  @@index([statuses_id], map: "messages_statuses_id_foreign")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model music_eras {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  name               String               @unique(map: "music_eras_name_unique") @db.VarChar(45)
  description        String?              @db.Text
  start_date         DateTime             @db.Date
  end_date           DateTime             @db.Date
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  contents           contents[]
  rel_musicians_eras rel_musicians_eras[]
}

model music_genres {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String                 @unique(map: "music_genres_name_unique") @db.VarChar(45)
  description          String?                @db.Text
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  originated_at        DateTime               @db.Date
  contents             contents[]
  rel_musicians_genres rel_musicians_genres[]
}

model musicians {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  first_name            String                  @db.VarChar(45)
  last_name             String?                 @db.VarChar(100)
  bio                   String?                 @db.Text
  birth_date            DateTime                @db.Date
  death_date            DateTime?               @db.Date
  created_at            DateTime                @default(now()) @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  rel_musician_contents rel_musician_contents[]
  rel_musicians_eras    rel_musicians_eras[]
  rel_musicians_genres  rel_musicians_genres[]
}

model notifications {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  message     String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  statuses_id BigInt    @db.UnsignedBigInt
  users_id    BigInt    @db.UnsignedBigInt
  statuses    statuses  @relation(fields: [statuses_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notifications_statuses1")
  users       users     @relation(fields: [users_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notifications_users1")

  @@index([statuses_id], map: "fk_notifications_statuses1_idx")
  @@index([users_id], map: "fk_notifications_users1_idx")
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.VarChar(255)
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

